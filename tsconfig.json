{
    "compilerOptions": {
        "useUnknownInCatchVariables": false,
        "strictNullChecks": false,
        "noImplicitAny": false,
        "noUnusedLocals": false,
        "noEmitOnError": false,
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "jsx": "react",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "module": "nodenext",
        "target": "esNext",
        "declaration": true,
        "outDir": "./dist",
        "types": [
            "node"
        ]
    },
    "include": [
        "**/**/**/*"
    ],
    "exclude": [
        "node_modules/**/**/*",
        "client/**/**/*",
        "dist/**/**/*",
    ]
}